<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationIcon>res\icon.ico</ApplicationIcon>

    <!-- Publish -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="res\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="ArchiveAfterPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_Timestamp>$([System.DateTime]::Now.ToString("yyyyMMdd_HHmmss"))</_Timestamp>
      <_ZipName>$(AssemblyName)_$(RuntimeIdentifier)_$(_Timestamp).zip</_ZipName>
      <_ArchiveDir>$(MSBuildProjectDirectory)\bin\Release-Archive</_ArchiveDir>
    </PropertyGroup>

    <MakeDir Directories="$(_ArchiveDir)" />
    <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(_ArchiveDir)\$(_ZipName)" Overwrite="true" />
    <Message Importance="high" Text="Archived: $(_ArchiveDir)\$(_ZipName)" />
  </Target>

</Project>
