<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <Version>2.1.0</Version>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>

    <ApplicationIcon>res\icon.ico</ApplicationIcon>

    <!-- Publish -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <Target Name="ArchiveAfterPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_Timestamp>$([System.DateTime]::Now.ToString("yyMMdd-HHmmss"))</_Timestamp>
      <_PackageType Condition="'$(SelfContained)' == 'true'">self-contained</_PackageType>
      <_PackageType Condition="'$(_PackageType)' == ''">portable</_PackageType>
      <_ZipName>$(AssemblyName)-$(RuntimeIdentifier)-$(_PackageType)-$(_Timestamp).zip</_ZipName>
      <_ArchiveDir>$(MSBuildProjectDirectory)\bin\Release-Archives</_ArchiveDir>
    </PropertyGroup>

    <ItemGroup>
      <_PublishedResourceFiles Include="$(PublishDir)res\**\*" />
    </ItemGroup>

    <RemoveDir Directories="$(PublishDir)res" Condition="Exists('$(PublishDir)res') and '@(_PublishedResourceFiles)' == ''" />
    <MakeDir Directories="$(_ArchiveDir)" />
    <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(_ArchiveDir)\$(_ZipName)" Overwrite="true" />
    <Message Importance="high" Text="Archived: $(_ArchiveDir)\$(_ZipName)" />
  </Target>

</Project>
